      <data key="d2">Visi Itenas adalah tujuan yang ingin dicapai oleh Itenas dalam menjalankan kegiatan pendidikan.</data>
      <data key="d3">chunk-bdb7a3358c8ce178008a6e04e96a16e6</data>
