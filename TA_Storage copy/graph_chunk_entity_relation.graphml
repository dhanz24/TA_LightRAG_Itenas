      <data key="d2">Kegiatan tridarma adalah kegiatan yang dilakukan oleh perguruan tinggi untuk mencapai tujuan pendidikan.</data>
      <data key="d3">chunk-bdb7a3358c8ce178008a6e04e96a16e6</data>
